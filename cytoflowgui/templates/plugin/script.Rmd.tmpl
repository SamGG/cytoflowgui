```{r setup, include=FALSE}
knitr::opts_chunk$set(echo = TRUE, message = FALSE, warning = FALSE)
```

```{r config, include=FALSE}
# ---- parameters written by cytoflowgui -------------------------------------
cfg <- jsonlite::read_json(params$params_file, simplifyVector = TRUE)
# shared helpers of cytoflowgui: log_msg, with_log, note, is_text, ...
source(file.path(cfg$helpers_dir, "helpers.R"), local = TRUE)

# ---- validation ------------------------------------------------------------
stopifnot(
  # {{#input}}
  "{{input_param}} must be a non-empty string" = is_text(cfg${{input_param}}),
  # {{/input}}
  "example_text must be a non-empty string" = is_text(cfg$example_text),
  "example_flag must be TRUE or FALSE" = is_flag(cfg$example_flag)
)
log_msg("Configuration validated")
```

## Processing

```{r process}
# ---- your analysis -----------------------------------------------------------
# Data to continue the analysis (FCS, RDS) goes to cfg$data_dir, end products
# (XLSX, text) to cfg$reports_dir. Create the folder before writing:
#   dir.create(cfg$data_dir, recursive = TRUE, showWarnings = FALSE)
# Load the packages here, and list them in plugin.toml ([requires] r / bioc).
log_msg("Processing...")
log_msg("Example text: %s", cfg$example_text)
# {{#input}}
log_msg("Input: %s", cfg${{input_param}})
# {{/input}}
write_session_info(cfg)
```

```{r report only, include=FALSE}
# Once the results are saved, an error in a report chunk must not fail the step.
report_only_from_here()
```

## Summary

```{r summary, echo=FALSE}
# {{#input}}
info <- step_info(
  cfg, "{{input_param}}",
  c(
    "Text" = cfg$example_text, "Option" = ifelse(cfg$example_flag, "Yes", "No")
  )
)
# {{/input}}
# {{^input}}
info <- step_info(
  cfg, NULL,
  c(
    "Text" = cfg$example_text, "Option" = ifelse(cfg$example_flag, "Yes", "No")
  )
)
# {{/input}}
knitr::kable(info)
```

